# Only the public application and its documentation belong in this repository.
# Local builds, browser profiles, media, exports, test fixtures and private rules
# are intentionally excluded. Add new public files explicitly below.
/*
!/.gitignore
!/README.md
!/LICENSE
!/app/
/app/*
!/app/MediaPlaylistViewer.html
!/app/Start-MediaPlaylistViewer.cmd
!/app/Lucide-LICENSE.txt
!/docs/
/docs/*
!/docs/PHOTO-CREDITS.md
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/gallery.jpg
!/docs/screenshots/detail.jpg
!/docs/screenshots/filters.jpg
!/docs/screenshots/tags.jpg
!/docs/screenshots/bulk-selection.jpg
!/docs/screenshots/bulk-tags.jpg
!/docs/screenshots/groups.jpg
!/docs/screenshots/auto-tag-rules.jpg
!/docs/screenshots/auto-tag-preview.jpg
!/docs/screenshots/mobile.jpg
